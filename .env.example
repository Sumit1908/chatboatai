# ==============================================================
# WhatsApp Broadcasting Platform - environment configuration
# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file.
# ==============================================================

# --- Core server ---
NODE_ENV=production
PORT=5000

# Public URL of the deployed site's ROOT domain (no trailing slash, no
# "app." prefix) — this is where marketing pages and /login live.
# Must exactly match a "Valid OAuth Redirect URI" host on your Meta App,
# and is used to build the Facebook Login callback URL: {APP_URL}/api/callback
# Also used for HTTPS host canonicalization redirects + HSTS.
APP_URL=https://yourdomain.com

# --- Root domain / app subdomain split (optional) ---
# Set these once app.<domain> is verified on Render. Leave unset to keep
# everything on a single origin (e.g. the raw onrender.com URL, or while
# developing locally) — both features below are no-ops until set.
#
# Server-side: enables host-based redirects (marketing+login stay on the
# root domain, app-only pages redirect to app.<domain>), see server/hostRouting.ts.
PRIMARY_DOMAIN=yourdomain.com
# Server-side: shares the login session cookie between the root domain and
# app.<domain> (must start with a dot). See server/auth/session.ts.
COOKIE_DOMAIN=.yourdomain.com
# Client-side (must be VITE_-prefixed to be exposed to the browser build):
# same value as PRIMARY_DOMAIN — used by the login page to redirect to
# app.<domain> after a successful sign-in, and to bounce logged-out
# visitors off the app subdomain back to root /login.
VITE_PRIMARY_DOMAIN=yourdomain.com

# Google Analytics 4 (content pages). Script is also hard-coded in index.html.
VITE_GA_MEASUREMENT_ID=G-LQX0MSZPW4

# Email / DNS (configure at your DNS provider — not an app env var):
# Add an SPF TXT record on the sending domain, e.g.
#   v=spf1 include:_spf.resend.com ~all
# so spammers cannot easily spoof mail from your sending domain.

# --- Database (Neon Postgres, or any Postgres connection string) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Sessions ---
# Any long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# --- Meta / Facebook App ---
# From https://developers.facebook.com -> Your App -> App Settings > Basic
# Used both for "Log in with Facebook" (website login) and for the
# WhatsApp Business embedded signup / OAuth connect flow.
FACEBOOK_APP_ID=your-meta-app-id
FACEBOOK_APP_SECRET=your-meta-app-secret

# --- Razorpay (subscription billing) ---
# From https://dashboard.razorpay.com -> Settings -> API Keys
# Use Test Mode keys until you're ready to accept real payments.
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# From Settings -> Webhooks, after adding {APP_URL}/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Optional: pre-created Razorpay plan IDs are no longer required —
# plans are managed in Admin → Billing plans and linked automatically.
# RAZORPAY_PLAN_ID_GROWTH=plan_xxx
# RAZORPAY_PLAN_ID_STARTER=plan_xxx
# Legacy alias for Growth plan:
# RAZORPAY_PLAN_ID=plan_xxx

# --- Cloudflare R2 (uploaded media storage) ---
# Optional. If any of these are missing, uploaded template/campaign media
# falls back to being stored as base64 in Postgres (the old behavior) -
# the app works fine either way, R2 just avoids buffering large files in
# server memory and keeps them out of the database.
# 1. Cloudflare dashboard -> R2 Object Storage -> create a bucket.
# 2. Copy the Account ID shown on the R2 overview page.
# 3. R2 -> Manage R2 API Tokens -> Create API Token, scoped to
#    "Object Read & Write" on just that bucket (not account-wide).
#    Leave the bucket private - the app serves all media itself through
#    /uploads/db/<id>, so R2 never needs public access enabled.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
# Emergency kill-switch: set to "postgres" to force all new uploads back
# to the database without touching the R2 credentials above.
UPLOAD_STORAGE_BACKEND=r2

# --- Upstash Redis (BullMQ broadcast / campaign queues) ---
# Free tier is enough. BullMQ needs the Redis protocol (not REST-only).
# Option A: paste both REST values from the Upstash console — the app will
# build rediss://default:TOKEN@HOST:6379 automatically.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# Option B: set the Redis URL explicitly (overrides the derived URL above).
# REDIS_URL=rediss://default:your-upstash-token@your-db.upstash.io:6379
